# KingPepe SDK example environment configuration.
# Copy to .env and fill in real values. NEVER commit a real .env.
#
# The SDK reads these variables via KingPepeClient.fromEnv() / from_env().

# RPC connection
KINGPEPE_RPC_HOST=127.0.0.1
# Default RPC ports: mainnet 24027, testnet 34027, signet 61883, regtest 18443
KINGPEPE_RPC_PORT=18443
KINGPEPE_RPC_USER=change_me
KINGPEPE_RPC_PASSWORD=change_me

# Optional: wallet name for wallet-scoped RPC (/wallet/<name>)
KINGPEPE_RPC_WALLET=

# Optional: network (mainnet | testnet | signet | regtest). Selects default port.
KINGPEPE_NETWORK=regtest

# Optional: transport
KINGPEPE_RPC_PROTOCOL=http
KINGPEPE_RPC_TIMEOUT=30000
# Set to 0 to disable TLS certificate verification (NOT recommended)
# KINGPEPE_RPC_TLS_REJECT_UNAUTHORIZED=1

# Integration tests are DISABLED unless this is set to 1. Regtest only.
KINGPEPE_SDK_RUN_INTEGRATION=0
